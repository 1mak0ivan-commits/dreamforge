# Скопируй в .env и заполни реальными значениями. .env НЕ должен попадать в git.

BOT_TOKEN=токен_от_BotFather

# true — разрешает открывать API без Telegram (для разработки в браузере).
# На проде обязательно поставь false.
DEV_MODE=true

OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3.1:8b-instruct-q4_K_M
MAX_HISTORY_MESSAGES=20
# Раз в сколько сообщений пробовать выжать новый факт о пользователе в память персонажа
MEMORY_EXTRACT_EVERY=4
# Раз в сколько сообщений обновлять скользящее резюме старой части разговора
SUMMARY_UPDATE_EVERY=20
# Контекстное окно модели. Если персонаж "теряет нить", повторяется или путается —
# скорее всего промпт (персонаж+мир+память+резюме+история) не помещается в это окно.
# Подними, если железо и модель позволяют (требует больше видеопамяти).
OLLAMA_NUM_CTX=4096
# Штраф за повторение слов/фраз. 1.0 = выключено. Если ответы зацикливаются на одних
# и тех же формулировках — подними до 1.2-1.3. Слишком высокое значение (>1.4) может
# заставить модель избегать даже уместных повторов (имён, простых слов).
OLLAMA_REPEAT_PENALTY=1.15

# --- OpenRouter (необязательно) ---
# Если задан ключ — реплики персонажей идут через OpenRouter вместо локальной Ollama.
# Служебные вызовы (память, резюме, промпты для картинок) ВСЕГДА остаются на Ollama,
# даже если ключ задан — экономит платный/лимитированный токен-бюджет OpenRouter.
# Оставь пустым, чтобы всё как раньше работало только через Ollama.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Проверь актуальный слаг модели на openrouter.ai/models — они периодически меняются.
OPENROUTER_MODEL=deepseek/deepseek-chat

IMAGE_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
IMAGE_GENERATE_EVERY=10

DATA_FILE=data.json
UPLOAD_DIR=uploads

CORS_ORIGINS=["*"]
